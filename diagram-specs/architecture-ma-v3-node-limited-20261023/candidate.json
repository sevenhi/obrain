  "cards": [
    {
      "dot": "cyan",
      "title": "两次分组别混为一谈",
      "items": [
        "外层:n_expert_groups 把 256 专家分逻辑组,只为「最多落到 4 个节点」服务",
        "内层:组内 top-8 才是真正的专家选择",
        "V2 也有 8 组 / top-3 组,但那纯粹为了负载均衡,没有节点维度"
      ]
    },
    {
      "dot": "rose",
      "title": "为什么是 top-2 求和而不是 max",
      "items": [
        "取 max 会让「一个明星专家带整组上去」,组内其他专家白搭",
        "top-2 求和让组得分反映「这组整体是否合适」",
        "这是 V3 源码里的具体实现,不是论文公式层面的抽象"
      ]
    },
    {
      "dot": "emerald",
      "title": "sigmoid 相对 softmax 的意义",
      "items": [
        "softmax 的分母把所有专家耦合在一起,单看一个分数没有绝对意义",
        "sigmoid 给每个专家一个独立的亲和度,更适合「先比较再归一化」",
        "归一化挪到 top-k 之后做,再乘 route_scale=2.5"
      ]
    },
    {
      "dot": "amber",
      "title": "收益的可验证形式",
      "items": [
        "通信:每 token 最多跨 4 节点 → 训练框架可实现近完全的计算-通信 overlap",
        "均衡:bias 动态调,不掉 token",
        "质量:aux loss 从 0.001 降到 0.0001 兜底,不再与主目标抢梯度"
      ]
    }
  ]

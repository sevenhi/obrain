  "cards": [
    {
      "dot": "cyan",
      "title": "三种周期对应三种线程数",
      "items": [
        "2^11213−1 → 256 线程",
        "2^23209−1 → 512 线程",
        "2^44497−1 → 1024 线程(状态越大能吃越多线程)"
      ]
    },
    {
      "dot": "amber",
      "title": "为什么 R 的查表放 texture 而不是 shared",
      "items": [
        "u4 只有 16 种取值,同 warp 不同线程的 u4 常常相等",
        "放 shared memory 会撞 bank conflict",
        "放寄存器又挤占 occupancy,所以只读缓存的 texture 最合适"
      ]
    },
    {
      "dot": "rose",
      "title": "两个硬约束",
      "items": [
        "一个 state 只能由一个 block 用,两个 block 不能操作同一 state",
        "参数集搜索极慢(p=11213 平均 338 秒/组),必须离线预生成、复用"
      ]
    }
  ]

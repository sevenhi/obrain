  "cards": [
    {
      "dot": "cyan",
      "title": "两条路的指标完全对不上",
      "items": [
        "TTFT(Time To First Token):几乎完全由 prefill 决定",
        "TPOT / ITL(Time Per Output Token):几乎完全由 decode 决定",
        "同实例混跑时互相干扰:长 prompt 的 prefill 拖慢同批 decode,TTFT 尖刺反污染 TPOT"
      ]
    },
    {
      "dot": "emerald",
      "title": "软融合 vs 硬分离(可叠加,不是替代)",
      "items": [
        "Chunked prefill(软融合):长 prefill 切块混进同一 batch;解耦弱,vLLM V1 默认策略",
        "PD 分离(硬分离):两池物理拆开,KV 过传输层;算力/带宽/调度各自独立",
        "PD 的 prefill 实例内部仍可 chunked,decode 实例内部仍是 continuous batching"
      ]
    },
    {
      "dot": "rose",
      "title": "三个方案的侧重不同",
      "items": [
        "DistServe:按 SLO 做资源放配,主推 goodput(双 SLO 同时达标的请求比例)",
        "Splitwise:phase splitting 落到共享集群,甚至同 GPU 按时间片切",
        "Mooncake:把 KVCache 当一等公民,围绕 KV 池做全局调度 + 分层存储(HBM/CPU/SSD)"
      ]
    },
    {
      "dot": "amber",
      "title": "五个失败点按五步看",
      "items": [
        "路由没预留 → prefill 超时 → 传输慢/断 → 接收缓冲满 → slot 映射不一致",
        "任一步出问题都要能降级回单体实例(不是全局失败)",
        "监控要加「配对成功率」与「路由降级率」,而不是只看 HTTP 200"
      ]
    }
  ]

      "row": 3,
      "col": 2
    },
    {
      "id": "kv",
      "type": "database",
      "label": "Fp8KVCacheMethod",
      "sublabel": "与先验 kernel 无关",
      "icon": "database",
      "row": 3,
      "col": 3
    },
    {
      "id": "card_ignored",
      "type": "external",
      "label": "IGNORED_LAYERS",

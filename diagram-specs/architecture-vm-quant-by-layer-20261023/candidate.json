    { "from": "cfg", "to": "lin", "label": "LinearBase 分支", "variant": "emphasis" },
    { "from": "lin", "to": "lin_online", "label": "在线量化走这里", "variant": "dashed" },
    { "from": "lin", "to": "lin_skip", "label": "命中则直通", "variant": "dashed" },
    { "from": "cfg", "to": "moe", "label": "MoE 分支" },
    { "from": "moe", "to": "mxfp4", "label": "store_dtype 判定", "variant": "dashed" },
    { "from": "cfg", "to": "attn", "label": "Attention 分支" },
    { "from": "attn", "to": "kv", "label": "只量化 KV cache" }

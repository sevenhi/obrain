  "cards": [
    {
      "dot": "cyan",
      "title": "三层各管一件事",
      "items": [
        "API 层(AsyncLLM):asyncio 接口、请求队列、流式输出;不做调度决策",
        "EngineCore:调度决策的唯一持有者(预算/块/抢占),独立进程",
        "执行层(Worker/GPUModelRunner):只消费 SchedulerOutput,无状态地跑"
      ]
    },
    {
      "dot": "emerald",
      "title": "两个 step 路径要分清",
      "items": [
        "不启用异步:step()(core.py:597)排的是本步 batch N,future.result() 等的就是这个批",
        "启用异步:step_with_batch_queue()(core.py:638),GPU 跑 batch N 时 CPU 已排好 N+1",
        "batch queue 仅当 max_concurrent_batches > 1(PP>1 或显式异步)才存在"
      ]
    },
    {
      "dot": "rose",
      "title": "进程模型的三个坑",
      "items": [
        "别以为 Worker 一定独立进程:单卡 UniProc 与 EngineCore 同进程持有",
        "async_scheduling 默认由 VllmConfig 裁决,多特性组合下会被强制关,别默认它开着",
        "只有 EngineCore↔AsyncLLM 这一段是稳定跨进程的(ZMQ)"
      ]
    },
    {
      "dot": "amber",
      "title": "SchedulerOutput 是「指令」不是「函数调用」",
      "items": [
        "scheduled_new_reqs / cached_reqs / running_reqs 三类",
        "num_scheduled_tokens 是本步喂给 GPU 的 token 总量",
        "req_to_new_blocks 给新请求分块,preempted_reqs 触发 recompute"
      ]
    }
  ]
}

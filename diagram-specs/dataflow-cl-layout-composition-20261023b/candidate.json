    {
      "label": "③ 下标当 A 的坐标"
    },
    {
      "label": "④ 经 A 落到内存"
    }
  ],
  "nodes": [
    {
      "id": "bcoord",
      "type": "frontend",
      "label": "B 坐标 (i,j)",
      "sublabel": "i∈[0,4), j∈[0,3)",

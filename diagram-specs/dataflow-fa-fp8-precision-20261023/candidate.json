{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "FA3 FP8 保精度:block quantization + incoherent processing",
    "subtitle": "FA3 的 FP8 不是简单把 Q 换 E4M3:按块量化防 outlier 拖垮,随机正交变换消 outlier,两项合计 2.6× 数值误差降低",
    "locale": "zh-CN",
    "output": "diagrams/fa-fp8-precision.dataflow.html"
  },
  "stages": [
    {
      "label": "① 预处理(保精度)"
    },
    {
      "label": "② 量化到 FP8"
    },
    {
      "label": "③ FP8 matmul"
    },
    {
      "label": "④ 第二个 FP8 GEMM"
    }
  ],
  "nodes": [
    {
      "id": "src",
      "type": "database",
      "label": "Q, K, V(BF16)",
      "sublabel": "含 outlier 的原始输入",
      "stage": 0,
      "row": 0
    },
    {
      "id": "incoh",
      "type": "backend",
      "label": "incoherent 处理",
      "sublabel": "Q,K 各乘正交矩阵 H",
      "stage": 0,
      "row": 1
    },
    {
      "id": "blockq",
      "type": "backend",
      "label": "block quantization",
      "sublabel": "按 128×128 / 1×128 块一个 scale",
      "stage": 1,
      "row": 0
    },
    {
      "id": "fp8",
      "type": "security",
      "label": "FP8 E4M3 张量",
      "sublabel": "scale 与 RoPE 融合,零额外开销",
      "stage": 1,
      "row": 1
    },
    {
      "id": "s",
      "type": "backend",
      "label": "S = Q_fp8 @ K_fp8ᵀ",
      "sublabel": "FP32 accumulate",
      "stage": 2,
      "row": 0
    },
    {
      "id": "p",
      "type": "backend",
      "label": "P=softmax(S) 降精",
      "sublabel": "shuffle 转布局后 downcast",
      "stage": 2,
      "row": 1
    },
    {
      "id": "o",
      "type": "backend",
      "label": "O = P_fp8 @ V_fp8",
      "sublabel": "第二个 GEMM 也是 FP8",
      "stage": 3,
      "row": 0
    }
  ],
  "flows": [
    {
      "id": "f1",
      "from": "src",
      "to": "incoh",
      "label": "Q、K(不含 V)"
    },
    {
      "id": "f2",
      "from": "src",
      "to": "blockq",
      "label": "Q、K、V 全部"
    },
    {
      "id": "f3",
      "from": "incoh",
      "to": "blockq",
      "label": "outlier 已被打散"
    },
    {
      "id": "f4",
      "from": "blockq",
      "to": "fp8",
      "label": "每块独立 scale"
    },
    {
      "id": "f5",
      "from": "fp8",
      "to": "s",
      "label": "Q_fp8、K_fp8"
    },
    {
      "id": "f6",
      "from": "s",
      "to": "p",
      "label": "FP32 分数"
    },
    {
      "id": "f7",
      "from": "p",
      "to": "o",
      "label": "P_fp8(不是 BF16!)"
    },
    {
      "id": "f8",
      "from": "fp8",
      "to": "o",
      "label": "V_fp8",
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "violet",
      "title": "incoherent processing 为什么无损",
      "items": [
        "Q、K 各乘随机正交/Hadamard 矩阵 H,复杂度 O(d log d)",
        "正交性:(QH)·(HᵀKᵀ) = Q·(H·Hᵀ)·Kᵀ = QKᵀ,分数不变",
        "作用:消除注意力分数里的 outlier,E4M3 才能表示"
      ]
    },
    {
      "dot": "cyan",
      "title": "block quantization 要点",
      "items": [
        "128×128 或 1×128 块,每块一个 scale",
        "避免全局 scale 被 outlier 拖垮",
        "scale 可与 RoPE 融合,零额外开销"
      ]
    },
    {
      "dot": "amber",
      "title": "性能与坑",
      "items": [
        "两项合计 2.6× 数值误差降低",
        "FP8 前向 ~1.2-1.3 PFLOPS(61-66% MFU,不是 80%)",
        "跳过这两项,outlier 会让精度崩——部署最常见的坑"
      ]
    }
  ]
}
{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "MLA 的 KV cache:只缓存 576 维,而不是 32768 维",
    "subtitle": "上排是计算路径(投影 → 拆分 → 升维 → attention),下排是缓存决策。关键在于:升维出的 128 头 K/V 是临时算出来的,不进 cache;真正驻留显存的只有低秩 latent c^KV(512)+ 解耦 RoPE 分量 k_pe(64)",
    "locale": "zh-CN",
    "output": "diagrams/ma-ds-mla-kv.dataflow.html",
    "viewBox": [1080, 420]
  },
  "stages": [
    { "label": "① 输入 h_t" },
    { "label": "② 联合投影" },
    { "label": "③ 拆两路" },
    { "label": "④ 升维与 RoPE" },
    { "label": "⑤ attention" }
  ],
  "nodes": [
    { "id": "h", "type": "frontend", "label": "hidden h_t", "sublabel": "5120 维", "stage": 0, "row": 0 },
    { "id": "proj", "type": "backend", "label": "kv_a_proj_with_mqa", "sublabel": "一次投影出 576", "stage": 1, "row": 0 },
    { "id": "split", "type": "backend", "label": "拆成两路", "sublabel": "512 + 64", "stage": 2, "row": 0 },
    { "id": "up", "type": "backend", "label": "kv_b_proj 升维", "sublabel": "512 → 128×(128+128)", "stage": 3, "row": 0 },
    { "id": "attn", "type": "cloud", "label": "标准 QK^T → softmax → AV", "sublabel": "再 o_proj 回 5120", "stage": 4, "row": 0 },

    { "id": "nope", "type": "database", "label": "k_nope + v 每头", "sublabel": "临时算,不缓存", "stage": 3, "row": 1 },
    { "id": "latent", "type": "security", "label": "缓存 c^KV:512 维", "sublabel": "全头共享一份 latent", "stage": 2, "row": 1 },
    { "id": "pe", "type": "security", "label": "缓存 k_pe:64 维", "sublabel": "1 头 MQA 式,解耦 RoPE", "stage": 3, "row": 1 },
    { "id": "rn", "type": "backend", "label": "kv_a_layernorm", "sublabel": "压缩后先归一化", "stage": 1, "row": 1 }
  ],
  "flows": [
    { "id": "f1", "from": "h", "to": "proj", "label": "一次投影", "route": "straight" },
    { "id": "f2", "from": "proj", "to": "split", "label": "576 维", "route": "straight" },
    { "id": "f3", "from": "split", "to": "up", "label": "512 维 latent 去升维", "route": "straight", "variant": "emphasis", "labelDy": -18 },
    { "id": "f4", "from": "up", "to": "attn", "label": "128 头 K/V", "route": "straight", "labelDy": -18 },
    { "id": "f5", "from": "up", "to": "nope", "label": "算完即弃", "route": "straight", "variant": "dashed", "labelDx": 40 },
    { "id": "f6", "from": "proj", "to": "rn", "label": "先归一", "route": "straight", "labelDx": 40 },
    { "id": "f7", "from": "rn", "to": "latent", "label": "存这一份", "route": "straight", "variant": "emphasis", "labelDx": 40 },
    { "id": "f8", "from": "split", "to": "pe", "label": "64 维位置分量", "route": "straight", "variant": "emphasis", "labelDx": 44 },
    { "id": "f9", "from": "latent", "to": "attn", "label": "decode 时读回升维", "route": "straight", "variant": "dashed" }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "为什么必须解耦 RoPE",
      "items": [
        "若 RoPE 直接作用在低秩压缩后的 K 上,位置信息会与「被所有头共享的压缩表示」纠缠",
        "解压回多头时位置信息就失效了",
        "所以拆成 q_nope/k_nope(不旋转)与 q_pe/k_pe(旋转),位置分量独立存储"
      ]
    },
    {
      "dot": "cyan",
      "title": "三档 KV cache 对比(每层每 token)",
      "items": [
        "MHA(128 头 × 128 维):2 × 128 × 128 = 32768 维",
        "GQA(8 KV 头 × 128 维):2 × 8 × 128 = 2048 维",
        "MLA:512 + 64 = 576 维 → 相对 MHA 约 1/57,相对 GQA 再压 ~3.6×"
      ]
    },
    {
      "dot": "emerald",
      "title": "Q 也低秩,但是为了别的",
      "items": [
        "q_a_proj 5120→1536 再 q_b_proj 1536→128×192",
        "省的是训练时激活显存与参数,不影响 KV cache",
        "所以「MLA 省显存」这句话要分清楚省的是哪种显存"
      ]
    },
    {
      "dot": "amber",
      "title": "源码读法提醒",
      "items": [
        "HF 版 forward 里 past_key_value.update 存的是展开后的 K/V",
        "但注释与论文都指出:推理真正只需缓存 c^KV + k_pe",
        "这正是 FlashMLA / absorb 实现优化的着力点"
      ]
    }
  ]
}

{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "一条请求的 PD 路径:五段交接,每一跳都是新的失败点",
    "subtitle": "上排是主干(路由 → prefill → KV 传输 → 注册 → 回收),下排是每段多出来的动作。传输单位是 KV block / slot,不是连续大 buffer——接收端要做 slot 映射才能直接进本地 block table",
    "locale": "zh-CN",
    "output": "diagrams/vm-pd-request-path.dataflow.html",
    "viewBox": [
      1080,
      400
    ]
  },
  "stages": [
    {
      "label": "① 入口路由"
    },
    {
      "label": "② Prefill"
    },
    {
      "label": "③ KV 交接"
    },
    {
      "label": "④ Decode 接管"
    },
    {
      "label": "⑤ 回收"
    }
  ],
  "nodes": [
    {
      "id": "pick",
      "type": "frontend",
      "label": "网关选实例",
      "sublabel": "按 prompt 长度",
      "stage": 0,
      "row": 0
    },
    {
      "id": "fwd",
      "type": "backend",
      "label": "prompt 前向",
      "sublabel": "可 chunked 切块",
      "stage": 1,
      "row": 0
    },
    {
      "id": "chan",
      "type": "messagebus",
      "label": "KV 传输通道",
      "sublabel": "RDMA / NVLink / 池",
      "stage": 2,
      "row": 0
    },
    {
      "id": "reg",
      "type": "database",
      "label": "写本地 block table",
      "sublabel": "slot 映射要一致",
      "stage": 3,
      "row": 0
    },
    {
      "id": "free",
      "type": "backend",
      "label": "两边释放 block",
      "sublabel": "结束即归还",
      "stage": 4,
      "row": 0
    },
    {
      "id": "hold",
      "type": "database",
      "label": "向 decode 预留",
      "sublabel": "先占位或后申请",
      "stage": 0,
      "row": 1
    },
    {
      "id": "art",
      "type": "database",
      "label": "产出 KV + 首 token",
      "sublabel": "不是 logits",
      "stage": 1,
      "row": 1
    },
    {
      "id": "pack",
      "type": "backend",
      "label": "按 slot 打包",
      "sublabel": "不传连续大 buffer",
      "stage": 2,
      "row": 1
    },
    {
      "id": "cont",
      "type": "backend",
      "label": "本地续 decode",
      "sublabel": "仍走 continuous batching",
      "stage": 3,
      "row": 1
    },
    {
      "id": "pool",
      "type": "cloud",
      "label": "池内保前缀",
      "sublabel": "按复用策略留块",
      "stage": 4,
      "row": 1
    }
  ],
  "flows": [

      "labelAt": [
        330,
        210
      ]
    },
    {
      "id": "f3",
      "from": "lists",
      "to": "uva",
      "label": "元数据走小拷贝",
      "route": "straight"
    },
    {
      "id": "f4",
      "from": "uva",
      "to": "kernel",
      "label": "给 kernel 定位每段",
      "route": "straight"
    },
    {
      "id": "f5",
      "from": "kernel",
      "to": "clear",
      "label": "写完即清",
      "route": "straight"
    }

  "meta": {
    "title": "StagedWriteTensor:五步代替「整张量重拷」",
    "subtitle": "block table 这类张量每步只有几行变化,整份 H2D 是纯浪费;MRV2 在 CPU 侧累积 diff,apply_write 一次 kernel 落盘,cu_lens 用前缀和让一个下标切出任意段",
    "locale": "zh-CN",
    "output": "diagrams/vm-staged-write.dataflow.html",
    "viewBox": [
      1080,
      380
    ]
  },
  "stages": [
    {
      "label": "① 基张量常驻 GPU"
    },
    {
      "label": "② CPU 攒 diff"
    },
    {
      "label": "③ 装进 UVA 环"
    },
    {
      "label": "④ 一个 kernel 落盘"
    },
    {
      "label": "⑤ 清空清单"
    }
  ],
  "nodes": [
    {
      "id": "base",
      "type": "database",
      "label": "GPU 基张量",
      "sublabel": "例如 (1024,1000) int32",
      "stage": 0,
      "row": 0
    },
    {
      "id": "stage",
      "type": "backend",
      "label": "stage_write 累积",
      "sublabel": "只记 4 个 list",
      "stage": 1,
      "row": 0
    },
    {
      "id": "lists",
      "type": "database",
      "label": "四个 list",
      "sublabel": "cu_lens 是前缀和",
      "stage": 1,
      "row": 1
    },
    {
      "id": "uva",
      "type": "database",
      "label": "UVA 环形缓冲",
      "sublabel": "元数据小拷贝",
      "stage": 2,
      "row": 0
    },
    {
      "id": "h2d",
      "type": "backend",
      "label": "contents 一次 H2D",
      "sublabel": "async_tensor_h2d",
      "stage": 2,
      "row": 1
    },
    {
      "id": "kernel",
      "type": "security",
      "label": "_apply_write_kernel",
      "sublabel": "BLOCK_SIZE=1024",
      "stage": 3,
      "row": 0
    },
    {
      "id": "clear",
      "type": "backend",
      "label": "清空 staged 列表",
      "sublabel": "下一轮重新攒",
      "stage": 4,
      "row": 0
    }
  ],
  "flows": [
    {
      "id": "f1",
      "from": "base",
      "to": "stage",
      "label": "只改几行几列",
      "route": "straight"
    },
    {
      "id": "f2",
      "from": "stage",
      "to": "lists",
      "label": "记 (row,start,内容)",

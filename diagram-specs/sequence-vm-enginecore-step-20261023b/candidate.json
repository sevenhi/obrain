    { "id": "m2", "from": "sched", "to": "core", "y": 216, "label": "SchedulerOutput:本步要算的 token 与块", "variant": "return" },
    { "id": "m3", "from": "core", "to": "exec", "y": 264, "label": "execute_model(non_block):不阻塞下发", "variant": "emphasis" },
    { "id": "m4", "from": "exec", "to": "gpu", "y": 312, "label": "batch 交给 worker 执行" },
    { "id": "m5", "from": "core", "to": "gram", "y": 360, "label": "同期算结构化输出 bitmask", "variant": "dashed", "note": "CPU 侧的活,和 GPU 计算并行" },

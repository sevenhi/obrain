  "cards": [
    {
      "dot": "cyan",
      "title": "每步全量重排",
      "items": [
        "不固定 batch 成员:完成/中止移出、新请求按预算进、运行中续 token",
        "没有任何「批」的概念存活超过一步",
        "这是连续批处理与静态批处理的根本区别"
      ]
    },
    {
      "dot": "emerald",
      "title": "异步调度",
      "items": [
        "用 batch queue 缓存多个已调度 batch",
        "GPU 跑 batch N 时,CPU 已在调度 batch N+1",
        "所以 non_block 下发 + future.result() 放到最后才阻塞"
      ]
    },
    {
      "dot": "amber",
      "title": "请求生命周期",
      "items": [
        "add_request → waiting",
        "被 schedule 选中 → running(分配 block)",
        "每步续 token → FINISHED / ABORTED → free",
        "抢占时:释放块进 LRU,computed 归零退回 waiting"
      ]
    },
    {
      "dot": "rose",
      "title": "行号口径",
      "items": [
        "core.py:597 是 step() 的行号(v1-architecture 篇同口径)",
        "scheduler.py:502-511 是统一 token 预算模型的注释",
        "源码 commit b74ac0bc6 为基准"
      ]
    }
  ]

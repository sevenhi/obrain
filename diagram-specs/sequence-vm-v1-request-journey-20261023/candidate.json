  "cards": [
    {
      "dot": "cyan",
      "title": "哪几段是启动期做的",
      "items": [
        "② 模型加载:ModelConfig.registry 解析 architectures → 实现类(懒加载)",
        "③ 量化层:get_quant_method() 换 *LinearMethod,create_weights 定义量化权重",
        "④ 分布式:Executor 创建 actor、下发 rendezvous、建 TP/PP 通信组"
      ]
    },
    {
      "dot": "emerald",
      "title": "为什么 EngineCore 不碰 detokenize",
      "items": [
        "EngineCore 只产 logits / 采样结果,经 ZMQ 回前端进程",
        "OutputProcessor / Detokenizer 在 API 进程,流式发送也在这里",
        "好处:引擎进程的循环里没有字符串处理,不为 IO 抖动买单"
      ]
    },
    {
      "dot": "rose",
      "title": "五段各自对应的篇",
      "items": [
        "① 入口 → api-server-openai-compat.md",
        "② 加载 → model-registry.md;③ 量化 → quantization-gptq-awq-fp8.md",
        "④ 分布式 → distributed-ray.md;⑤ 采样 → sampling-penalties.md"
      ]
    },
    {
      "dot": "amber",
      "title": "定位问题看落点",
      "items": [
        "请求进不来 → EngineCore / 调度器(预算、KV 块)",
        "跑得慢 → Worker / GPUModelRunner(kernel、attention backend)",
        "卡在 API、流断断续续 → AsyncLLM(流式缓冲)"
      ]
    }
  ]
}
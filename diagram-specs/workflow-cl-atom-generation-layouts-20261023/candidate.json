    { "id": "tri", "lane": "ln_common", "col": 0, "type": "cloud", "label": "共同动作:由 ThrID + 值布局推出", "sublabel": "traits 给的是 (thr,val)→MNK,使用侧要它的逆", "width": 200 },
    { "id": "inv", "lane": "ln_common", "col": 1, "type": "backend", "label": "取逆由 CuTe 代数给", "sublabel": "right_inverse / left_inverse", "width": 180 },
    { "id": "res", "lane": "ln_common", "col": 2, "type": "external", "label": "结论:没有平凡办法跨代", "sublabel": "只能把复杂度封进 Atom", "icon": "decision", "width": 190 }
  ],
  "edges": [
    { "id": "e1", "from": "p1", "to": "p2", "label": "单线程视角", "role": "main" },
    { "id": "e2", "from": "p2", "to": "p3", "label": "值直接落在寄存器", "role": "main" },
    { "id": "e3", "from": "p1", "to": "v1", "label": "进入 tensor core", "role": "branch" },
    { "id": "e4", "from": "v1", "to": "v2", "label": "线程开始分摊数据", "role": "main" },
    { "id": "e5", "from": "v2", "to": "v3", "label": "C 的值布局变得不规则", "role": "main" },
    { "id": "e6", "from": "v1", "to": "a1", "label": "协作范围扩到整 warp", "role": "branch" },
    { "id": "e7", "from": "a1", "to": "a2", "label": "M 翻倍、K 翻倍", "role": "main" },
    { "id": "e8", "from": "a2", "to": "a3", "label": "布局跟着重写", "role": "main" },
    { "id": "e9", "from": "a3", "to": "tri", "label": "三代都要回答同一问", "role": "main" },
    { "id": "e10", "from": "tri", "to": "inv", "label": "方向是反的", "role": "main" },
    { "id": "e11", "from": "inv", "to": "res", "label": "所以必须封装", "role": "main" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Atom 到底是什么",
      "items": [
        "Atom = MMA_Op(裸 PTX)+ MMA_Traits(PTX 元信息)",
        "对外提供 checked call 接口与 fragment 生成",
        "traits 编码 ISA 里不表达的语义:值类型、collective 的线程布局、[thr_id, val_id] → 逻辑坐标 (M,N,K) 的数据布局映射"
      ]
    },
    {
      "dot": "rose",
      "title": "方向千万别搞反",
      "items": [
        "traits 里的 layout 是 (thr,val) 域 → MNK 逻辑坐标",
        "使用侧一般想要它的逆(MNK → thr,val)",
        "取逆由 CuTe 代数的 right_inverse / left_inverse 完成,不要手推",
        "手推这一层就是 CUTLASS 2.x 每代重写 indexing math 的老路"
      ]
    },
    {
      "dot": "emerald",
      "title": "三代差异一句话",
      "items": [
        "Pascal DP4A:ThrID = 1,无 Shape_MNK,1 线程 4 个 A 值",
        "Volta 8x8x4:8 线程 quadpair,ThrID = Layout<Shape<_4,_2>, Stride<_1,_16>>,CLayout 三层嵌套",
        "Ampere 16x8x8:整 warp(ThrID = 32),M/K 都翻倍,布局完全重写"
      ]
    }
  ]
}

    "locale": "zh-CN",
    "output": "diagrams/cl-atom-generation-layouts.workflow.html"
  },
  "lanes": [
    { "id": "ln_passcal", "label": "Pascal:DP4A 点积(单线程)" },
    { "id": "ln_volta", "label": "Volta:8x8x4(quadpair)" },
    { "id": "ln_ampere", "label": "Ampere:16x8x8(整 warp)" },
    { "id": "ln_common", "label": "三代共用的一层" }
  ],
  "phases": [
    { "id": "ph1", "label": "谁在协作", "fromCol": 0, "toCol": 0 },
    { "id": "ph2", "label": "吃什么形状、各拿什么值", "fromCol": 1, "toCol": 2, "variant": "emphasis" }
  ],
  "mainPath": ["p1", "p2", "p3"],
  "nodes": [
    { "id": "p1", "lane": "ln_passcal", "col": 0, "type": "external", "label": "ThrID = 1 个线程", "sublabel": "tensor core 之前", "icon": "start", "width": 165 },
    { "id": "p2", "lane": "ln_passcal", "col": 1, "type": "backend", "label": "无 Shape_MNK", "sublabel": "ALayout 1 线程 4 值", "width": 155 },
    { "id": "p3", "lane": "ln_passcal", "col": 2, "type": "database", "label": "int8 → int32", "sublabel": "CLayout 1 线程 1 值", "width": 155 },

    { "id": "v1", "lane": "ln_volta", "col": 0, "type": "security", "label": "ThrID = 8 线程", "sublabel": "4×2 quadpair", "width": 165 },
    { "id": "v2", "lane": "ln_volta", "col": 1, "type": "backend", "label": "Shape 8×8×4", "sublabel": "A 布局 (T8,V4)→(M8,K4)", "width": 175 },
    { "id": "v3", "lane": "ln_volta", "col": 2, "type": "database", "label": "C 布局三层嵌套", "sublabel": "(T8,V8)→(M8,N8),stride 16/4/8/2/32", "width": 185 },

    { "id": "a1", "lane": "ln_ampere", "col": 0, "type": "security", "label": "ThrID = 32 线程", "sublabel": "整 warp 协作", "width": 165 },
    { "id": "a2", "lane": "ln_ampere", "col": 1, "type": "backend", "label": "Shape 16×8×8", "sublabel": "fp16 输入 fp32 累加", "width": 155 },

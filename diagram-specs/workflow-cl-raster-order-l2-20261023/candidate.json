{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "rasterization order:为什么调这一根旋钮就能提升 L2 命中",
    "subtitle": "rasterization 决定 threadblock 沿哪个方向、按什么顺序领 tile。相邻 CTA 若处理内存相邻的 tile,它们读的 A/B 数据带会在 L2 里互相命中 —— 这比换调度器更基础,也是日常最常动的参数",
    "locale": "zh-CN",
    "output": "diagrams/cl-raster-order-l2.workflow.html"
  },
  "lanes": [
    { "id": "ln_bad", "label": "不调:行顺序直接领" },
    { "id": "ln_good", "label": "调 swizzle:分组错开" },
    { "id": "ln_knob", "label": "两根旋钮" }
  ],
  "phases": [
    { "id": "ph1", "label": "领 tile 的顺序", "fromCol": 0, "toCol": 1 },
    { "id": "ph2", "label": "对 L2 的后果", "fromCol": 2, "toCol": 2, "variant": "emphasis" }
  ],
  "mainPath": ["row", "adj", "miss"],
  "nodes": [
    { "id": "row", "lane": "ln_bad", "col": 0, "type": "frontend", "label": "沿行顺序领", "sublabel": "CTA 0、1、2… 排成一行", "icon": "start", "width": 165 },
    { "id": "adj", "lane": "ln_bad", "col": 1, "type": "backend", "label": "相邻 CTA 跨列", "sublabel": "各自读不同的 A 行带", "width": 170 },
    { "id": "miss", "lane": "ln_bad", "col": 2, "type": "security", "label": "L2 命中率低", "sublabel": "同一份 B 被反复从 DRAM 拉", "icon": "failure", "width": 185 },

    { "id": "swz", "lane": "ln_good", "col": 1, "type": "backend", "label": "按组切块错开", "sublabel": "max_swizzle_size = 1/2/4/8", "width": 180 },
    { "id": "band", "lane": "ln_good", "col": 2, "type": "security", "label": "同组复用同一条带", "sublabel": "A 或 B 的数据带落进 L2", "icon": "success", "width": 185 },

    { "id": "dir", "lane": "ln_knob", "col": 0, "type": "database", "label": "RasterOrder", "sublabel": "AlongM / AlongN 选主方向", "width": 165 },

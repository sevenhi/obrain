  "edges": [
    { "id": "e1", "from": "row", "to": "adj", "label": "线性推进", "role": "main" },
    { "id": "e2", "from": "adj", "to": "miss", "label": "数据带互不相邻", "role": "error" },
    { "id": "e3", "from": "miss", "to": "swz", "label": "把索引分组", "role": "branch" },
    { "id": "e4", "from": "swz", "to": "band", "label": "组内 CTA 挤在同带", "role": "main" },
    { "id": "e5", "from": "swz", "to": "dir", "label": "先定主方向", "role": "branch" },
    { "id": "e6", "from": "dir", "to": "size", "label": "再定组大小", "role": "main" },
    { "id": "e7", "from": "size", "to": "where", "label": "落成 config", "role": "main" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "几何直觉(§3.4 原文)",
      "items": [
        "相邻 threadblock 若处理内存相邻的 tile,它们读 A/B 的 tile 片会在 L2 里互相命中 → 提高命中率、减少 DRAM 读",
        "反之若各读各的远隔片,则 L2 复用差",
        "所以光栅方向不是细节,是访存效率的核心"
      ]
    },
    {
      "dot": "rose",
      "title": "方向要和 operand 复用形状配合调",
      "items": [
        "沿哪个维度的数据带被复用,取决于 A/B 的 tile 如何被多个 CTA 共享",
        "这是「日常最常动」的调度参数,比换 Stream-K 更基础",
        "默认 persistent 调度先调 RasterOrder + max_swizzle,再考虑换调度器"
      ]
    },
    {
      "dot": "amber",
      "title": "swizzle 的直观理解",
      "items": [
        "若 tile 按行顺序领,相邻 CTA 同时碰同一行相邻段 → L2 抖动",
        "swizzle 让每个 CTA 领到的 tile 在地址上均匀错开,提高复用",
        "配置位置:scheduler 的 Arguments(如 PersistentTileSchedulerSm90StreamK::Arguments 的 raster_order / max_swizzle_size)",
        "example 48 用 arguments.scheduler.raster_order / arguments.scheduler.max_swizzle_size 访问"
      ]
    }
  ]
}

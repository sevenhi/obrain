  "cards": [
    {
      "dot": "rose",
      "title": "代价一:增益失控",
      "items": [
        "单个 H_res 行和 ≠ 1,连乘几十层 ∏ H_res 会放大",
        "27B 实测复合增益峰值 ~3000,不是个别路径而是整条链路一起抖",
        "HC 在 ~12k step 出现 loss 突增(论文 Fig.2)"
      ]
    },
    {
      "dot": "emerald",
      "title": "双随机矩阵的三条性质",
      "items": [
        "非扩张:谱范数 ‖H‖₂ ≤ 1,单层增益有界",
        "乘法封闭:双随机 × 双随机 = 双随机 → 任意深度都守恒",
        "凸组合:H·x 是 n 条流的凸组合,均值守恒"
      ]
    },
    {
      "dot": "cyan",
      "title": "边界情形与统一",
      "items": [
        "n=1 时双随机退化成标量 1,即原始恒等映射",
        "「残差」与「HC」变成同一族的两端",
        "H_pre / H_post 只做非负约束(sigmoid / 2·sigmoid),防正负抵消"
      ]
    },
    {
      "dot": "amber",
      "title": "别搞错收益来源",
      "items": [
        "收益来自 n 条流的拓扑 + 流间混合,H_res 才是主力",
        "稳定性来自双随机的乘法封闭性,单层归一化替代不了",
        "代价:n=4 大规模训练增加 6.7% 时间(净值,已含重算与通信重叠)"
      ]
    }

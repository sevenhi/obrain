  "cards": [
    {
      "dot": "rose",
      "title": "账单公式(论文 Tab.2,每 token 每残差层)",
      "items": [
        "标准残差(残差合并):读 2C、写 C",
        "HC 未融合:读 (5n+1)C+n²+2n、写 (3n+1)C+n²+2n",
        "代入 n=4:读 21C+24、写 13C+24 → 约 10.5× 读、13× 写"
      ]
    },
    {
      "dot": "emerald",
      "title": "融合回收多少",
      "items": [
        "H_post + H_res 的应用与残差合并融成一个 kernel(F_post,res)",
        "读 (3n+1)C → (n+1)C;写 3nC → nC",
        "n=4:读 13C→5C、写 12C→4C——就是 §4 那个 kernel 的 WG1–WG3"
      ]
    },
    {
      "dot": "amber",
      "title": "另外两笔账",
      "items": [
        "显存:pre/post/res 参数要留中间激活给反向 → 必须上 checkpoint",
        "通信:流水并行下残差流宽 n 倍,PP 通信量 ~n 倍,气泡变大",
        "净账:n=4 大规模训练仍只增加 6.7% 时间"
      ]
    },
    {
      "dot": "cyan",
      "title": "所以它是带宽题",
      "items": [
        "昇腾 prenorm GEMM:M=8192 时只有 82 TFLOPS,带宽却到 3.4 TB/s(接近 HBM 上限)",
        "优化全部围绕「少搬一遍」,不是「少算一次」",
        "⚠ 昇腾口径含 padding/读写合计,别按裸 M 反推带宽"
      ]
    }
  ]

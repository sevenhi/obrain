  "cards": [
    {
      "dot": "cyan",
      "title": "24 这个数是几何决定的",
      "items": [
        "kNumHCOutputs = n(n+2) = n + n + n² = 24(n=4)",
        "正好是 pre(n) + post(n) + res(n²) 的系数总数",
        "一个 warp 用 24 条 lane 就能同时持有全部输出系数 → Mix 单 warp 完成"
      ]
    },
    {
      "dot": "amber",
      "title": "寄存器池的关键技巧",
      "items": [
        "dealloc 是 per-role 而非 per-task:降额后不会再加回去",
        "所以任务循环的热路径必须用低额度那套寄存器",
        "WG3/WG4 一开始就降到 40,因为它们是轻量归约",
        "静态断言 kMaxRegisterBudget×128 ≤ 64512 守着单 SM 总量"
      ]
    },
    {
      "dot": "rose",
      "title": "编译期常量(源码 layout/mega_mhc.cuh)",
      "items": [
        "kNumRoutes=4(硬编,要 n=2/8 得改常量重编 JIT)",
        "BLOCK_M=64、BLOCK_N=24、BLOCK_K=64",
        "kNumIOStages=4、kNumAStages=4、kNumThreads = 6×4×32 = 768"
      ]
    },
    {
      "dot": "emerald",
      "title": "一个 loop 干完的事",
      "items": [
        "new_residual = x⊗post_mix + comb_res_mix@residual(流更新)",
        "TF32 GEMM mixes = new_residual@fnᵀ(系数 logit)",
        "→ 重排后的 RMSNorm → sigmoid / Sinkhorn → 融合 Norm(可选 FP8)"
      ]
    },
    {
      "dot": "violet",
      "title": "屏障缓冲",
      "items": [
        "2 条 × 16384 行 × 128 B = 4 MiB",
        "按 CUDA stream 缓存(split_barriers_by_stream)",
        "不同 stream 的并发调用互不干扰(单测明确验证)"
      ]
    }
  ]

  "cards": [
    {
      "dot": "cyan",
      "title": "为什么必须 node-limited routing",
      "items": [
        "M=4:每 token 最多发往 4 个节点,把 IB 流量限到可重叠范围",
        "不设限制,IB 跳数随 top-8 路由发散,重叠就失效",
        "论文把它当前提条件,不是可选优化"
      ]
    },
    {
      "dot": "amber",
      "title": "为什么 EP64 跨 8 节点能跑",
      "items": [
        "平均每节点 3.2 个 expert(M=4 × top-8 的自然结果)",
        "密度高 → NVLink 转发几乎零额外开销",
        "NVLink 160 GB/s vs IB 50 GB/s,约 3.2× 差距是设计支点"
      ]
    },
    {
      "dot": "rose",
      "title": "通信 SM 必须显式配比",
      "items": [
        "H800 共 132 SM,论文口径只给通信 20 个",
        "占多了 GEMM 掉速,占少了 a2a 藏不住",
        "dispatch/combine 各三段,每段独立 warp 组,warp 数按负载动态调"
      ]
    }
  ]

    { "id": "s_what", "lane": "ln_esft", "col": 0, "type": "backend", "label": "训被选专家本体", "sublabel": "不新增任何结构", "icon": "success" },
    { "id": "s_when", "lane": "ln_esft", "col": 1, "type": "backend", "label": "MoE 领域定制", "sublabel": "稀疏结构自己说该训谁", "icon": "success" },
    { "id": "s_rel", "lane": "ln_esft", "col": 2, "type": "cloud", "label": "PEFT 的 MoE 特化版", "sublabel": "本篇讲的就是这一行", "icon": "none" },

    { "id": "r_what", "lane": "ln_rl", "col": 0, "type": "backend", "label": "调全模型策略", "sublabel": "梯度来自奖励而非标签", "icon": "neutral" },
    { "id": "r_when", "lane": "ln_rl", "col": 1, "type": "backend", "label": "激励推理能力", "sublabel": "长链思考涌现", "icon": "neutral" },

    { "id": "e6", "from": "s_when", "to": "s_rel", "label": "定位", "role": "main" },
    { "id": "e7", "from": "r_what", "to": "r_when", "label": "奖励驱动", "role": "main" },
    { "id": "e8", "from": "r_when", "to": "r_rel", "label": "目标差异", "role": "main" },
    { "id": "e9", "from": "e_what", "to": "e_when", "label": "部署阶段才发生", "role": "main" },
    { "id": "e10", "from": "e_when", "to": "e_rel", "label": "层级不同", "role": "main" }
  ],
  "mainPath": ["s_what", "s_when", "s_rel"],
  "cards": [
    {
      "dot": "violet",
      "title": "ESFT 与 LoRA 为什么正交",
      "items": [
        "LoRA 回答「用什么结构承载改动」:低秩旁路",
        "ESFT 回答「哪些参数需要改动」:被激活的那批专家",
        "两者可叠加:先按专家圈定范围,再在范围内挂低秩旁路"
      ]
    },
    {
      "dot": "rose",
      "title": "最容易踩的混淆:ESFT vs EPLB",
      "items": [
        "ESFT:训练阶段决定「谁被训练」,改的是权重数值",
        "EPLB/LPLB:推理阶段决定「专家放哪张卡」,搬副本不改数值",
        "一个落在 checkpoint 里,一个落在部署拓扑里"
      ]
    },
    {
      "dot": "emerald",
      "title": "什么时候不该用 ESFT",
      "items": [
        "数据量足够大、算力存储不紧张 → 全量微调效果上限仍更高",
        "目标是推理行为(长链思考)→ 走 R1 式 RL,不是知识注入",
        "基座不是 MoE → 没有专家可选,只能走 LoRA 或全量"
      ]
    }
  ]
}

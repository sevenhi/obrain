  "cards": [
    {
      "dot": "cyan",
      "title": "三代超参一眼对照",
      "items": [
        "V1-7B:30 层 / 4096 / 32 头 MHA / dense / 7B 激活 7B",
        "V1-67B:95 层 / 8192 / 64 Q : 8 KV(GQA)/ dense / 67B",
        "DeepSeekMoE-16B:28 层 / 2048 / 16 头 MHA / 2 共享 + 64 路由 top-6 / 16.4B 激活 2.8B",
        "V2:60 层 / 5120 / 128 头 MLA / 2 共享 + 160 路由 top-6 / 236B 激活 21B"
      ]
    },
    {
      "dot": "emerald",
      "title": "首层为什么保持 dense",
      "items": [
        "论文观察:首层的负载均衡状态收敛特别慢",
        "所以 first_k_dense_replace=1,第一层仍是 dense FFN",
        "V2 继承了这个设计(first_k_dense_replace=1, moe_layer_freq=1)"
      ]
    },
    {
      "dot": "rose",
      "title": "两条主线的物理约束",
      "items": [
        "KV cache 显存:GQA 砍「头数」,MLA 砍「维度」——从 32768 维/token 压到 576",
        "算力 FLOPs:MoE 只激活 6/160 个专家,激活参数 21B / 236B",
        "两条线在 V2 第一次合流,这是本篇最重要的结论"
      ]
    },
    {
      "dot": "amber",
      "title": "数字口径提醒",
      "items": [
        "专家相对 FFN 大小 0.25× 是「相对标准专家」(论文 Table 口径),不是相对 dense FFN",
        "16B 的 moe_intermediate_size=1408 对 dense 10944 约 0.129",
        "V1 论文正确 arXiv ID 是 2401.02954(不是常被误写的 2302.09500)"
      ]
    }
  ]

  "cards": [
    {
      "dot": "cyan",
      "title": "两个机制各解决什么",
      "items": [
        "细粒度专家分割:把 N 个标准专家切成 mN 个小专家、激活 mK 个 → 组合更灵活,知识更聚焦",
        "共享专家隔离:Ks 个恒激活,吃共性知识 → 路由专家不必重复学共性,减少冗余",
        "经验最优比:共享专家 : 激活路由专家 = 1 : 3"
      ]
    },
    {
      "dot": "emerald",
      "title": "分组受限贪心(V2 的做法)",
      "items": [
        "160 专家分 8 组 → 先按组内 max 得分选 top-3 组",
        "再在选中组内选 top-6 专家",
        "比全量 top-6 更能保证「专家在组间均衡」,缓解负载不均"
      ]
    },
    {
      "dot": "rose",
      "title": "数字口径的坑",
      "items": [
        "「0.25× 相对标准专家」是论文 Table 口径,不是相对 dense FFN",
        "16B 的 moe_intermediate_size=1408 对 dense 10944 约 0.129",
        "V2 每专家 1536,对 dense 12288 是 0.125×"
      ]
    },
    {
      "dot": "amber",
      "title": "aux loss 是 V2 的方案",
      "items": [
        "V2 仍是「aux loss」负载均衡(seq_aux=True, α=0.001)",
        "到 V3 才换成 aux-loss-free(bias 项动态调节)",
        "共享专家不参与路由,所以也不进 aux loss 的统计"
      ]
    }
  ]

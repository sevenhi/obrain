    { "id": "pool", "lane": "convert", "col": 2, "type": "security", "label": "组内 K/V 均值池化", "sublabel": "实测优于只留一头 / 随机重初始化", "width": 150 },
    { "id": "uptrain", "lane": "train", "col": 3, "type": "backend", "label": "续训 α=5% 原步数", "sublabel": "沿用原预训练配方", "width": 150 },
    { "id": "eval", "lane": "result", "col": 4, "type": "database", "label": "8 个 dev 集平均质量", "sublabel": "T5-XXL:GQA-8 = 47.1", "width": 150 },

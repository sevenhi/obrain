  ],
  "phases": [
    { "id": "ph1", "label": "两条线性投影", "fromCol": 0, "toCol": 2 },
    { "id": "ph2", "label": "乘性门控后压回 d", "fromCol": 3, "toCol": 5, "variant": "emphasis" }
  ],
  "mainPath": ["std_x", "std_w1", "std_ac", "std_w2", "std_p"],
  "nodes": [
    { "id": "std_x", "lane": "ln_std", "col": 0, "type": "frontend", "label": "输入 x", "sublabel": "逐位置,d 维", "icon": "start" },
    { "id": "std_w1", "lane": "ln_std", "col": 1, "type": "backend", "label": "线性层 W₁", "sublabel": "升到 4d" },
    { "id": "std_ac", "lane": "ln_std", "col": 2, "type": "security", "label": "ReLU", "sublabel": "max(0,·) 硬截断" },
    { "id": "std_w2", "lane": "ln_std", "col": 3, "type": "backend", "label": "线性层 W₂", "sublabel": "压回 d" },
    { "id": "std_p", "lane": "ln_std", "col": 4, "type": "database", "label": "参数量 8d²", "sublabel": "两个 d×4d 矩阵", "icon": "neutral" },

    { "id": "gate_in", "lane": "ln_gate", "col": 0, "type": "frontend", "label": "同一份 x", "sublabel": "分两路走", "icon": "start" },

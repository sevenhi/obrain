      "width": 150,
      "yOffset": 122
    },
    {
      "id": "avalanche",
      "lane": "ln_in",
      "col": 1,
      "type": "external",
      "label": "乘子怎么来",
      "sublabel": "χ² 量化 avalanche + 遗传式搜索",
      "icon": "neutral",
      "width": 150,
      "yOffset": 122
    }
  ],
  "edges": [
    { "id": "e1", "from": "c0", "to": "mul0", "label": "取低半", "role": "main" },
    { "id": "e2", "from": "mul0", "to": "hi1", "label": "两块各算高低半", "role": "main", "variant": "emphasis" },
    { "id": "e3", "from": "hi1", "to": "cnext", "label": "高半拿来交叉", "role": "main" },
    { "id": "e4", "from": "cnext", "to": "weyl", "label": "本轮状态成型", "role": "main" },
    { "id": "e5", "from": "weyl", "to": "loop", "label": "第 10 轮收尾", "role": "main" },
    { "id": "e6", "from": "weyl", "to": "mul0", "label": "没到 10 轮就回炉", "role": "branch", "variant": "dashed" },
    { "id": "e7", "from": "avalanche", "to": "mul0", "label": "定下 M0/M1", "role": "branch", "variant": "dashed" },
    { "id": "e8", "from": "rounds", "to": "loop", "label": "才是实际用的轮数", "role": "branch", "variant": "dashed" }

    "output": "diagrams/rng-philox-round.workflow.html"
  },
  "lanes": [
    { "id": "ln_in", "label": "① 输入 4 字" },
    { "id": "ln_sbox", "label": "② 乘法扩散" },
    { "id": "ln_pbox", "label": "③ 交叉与异或" },
    { "id": "ln_key", "label": "④ key 推进" }
  ],
  "phases": [
    { "id": "ph1", "label": "一轮之内", "fromCol": 0, "toCol": 2 },
    { "id": "ph2", "label": "轮末更新", "fromCol": 3, "toCol": 4, "variant": "emphasis" },
    { "id": "ph3", "label": "重复到第 10 轮", "fromCol": 5, "toCol": 5 }
  ],
  "mainPath": ["c0", "mul0", "hi1", "cnext", "weyl", "loop"],
  "nodes": [
    {
      "id": "c0",
      "lane": "ln_in",
      "col": 0,
      "type": "frontend",
      "label": "计数器 c0 / c2",
      "sublabel": "4×32-bit 里的两个",
      "icon": "start",
      "width": 150
    },
    {
      "id": "mul0",
      "lane": "ln_sbox",
      "col": 1,
      "type": "backend",
      "label": "mullo(c, M)",
      "sublabel": "M0=0xD2511F53",
      "icon": "active",
      "width": 150
    },
    {
      "id": "hi1",
      "lane": "ln_sbox",
      "col": 2,
      "type": "backend",
      "label": "mulhi(c, M)",
      "sublabel": "M1=0xCD9E8D57",
      "icon": "active",
      "width": 150
    },
    {
      "id": "cnext",
      "lane": "ln_pbox",
      "col": 3,
      "type": "backend",
      "label": "重排 + 异或 key",

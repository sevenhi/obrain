  "meta": {
    "title": "vLLM-Omni 的 stage 流水线:入口 → 编排 → 三阶段",
    "subtitle": "Thinker(AR)→Talker/DiT→Code2Wav/VAE 线性推进;级间 payload/KV 经 OmniConnector 直传,不落地序列化",
    "locale": "zh-CN",
    "output": "diagrams/vm-omni-stage-pipeline.workflow.html"
  },
  "lanes": [
    {
      "id": "ln_entry",
      "label": "① 入口"
    },
    {
      "id": "ln_orch",
      "label": "② 编排层"
    },
    {
      "id": "ln_stage",
      "label": "③ Stage 运行时"
    }
  ],
  "nodes": [
    {
      "id": "api",
      "lane": "ln_entry",
      "col": 0,
      "type": "frontend",
      "label": "客户端入口",
      "sublabel": "HTTP/WS/Python"
    },
    {
      "id": "orch",
      "lane": "ln_orch",
      "col": 1,
      "type": "backend",
      "label": "Omni Orchestrator",
      "sublabel": "stage 提交/生命周期"
    },
    {
      "id": "s0",
      "lane": "ln_stage",
      "col": 2,
      "type": "cloud",
      "label": "Stage0 Thinker(AR)",
      "sublabel": "连续批处理+Paged KV"
    },
    {
      "id": "s1",
      "lane": "ln_stage",
      "col": 2,
      "type": "cloud",
      "label": "Stage1 Talker/DiT",
      "sublabel": "扩散/codec 生成",
      "yOffset": 120
    },
    {
      "id": "s2",
      "lane": "ln_stage",
      "col": 2,
      "type": "cloud",
      "label": "Stage2 Code2Wav/VAE",
      "sublabel": "波形/像素解码",
      "yOffset": 240
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": "api",
      "to": "orch",
      "label": "请求进入",
      "role": "main"
    },
    {
      "id": "e2",
      "from": "orch",
      "to": "s0",
      "label": "提交 stage0",
      "role": "main"
    },
    {
      "id": "e3",
      "from": "s0",
      "to": "s1",
      "label": "payload/KV(OmniConnector)",
      "role": "main",
      "variant": "emphasis"
    },
    {
      "id": "e4",
      "from": "s1",
      "to": "s2",
      "label": "codec/latent(OmniConnector)",
      "role": "main",
      "variant": "emphasis"
    }
  ],
  "mainPath": [
    "api",
    "orch",
    "s0",
    "s1",
    "s2"
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "跨阶段传输三种 connector",
      "items": [
        "SharedMemory:同节点手递手",
        "MooncakeConnector:AR→DiT KV handoff",
        "NixlConnector:RDMA/UCX 跨节点,payload 不限于张量"
      ]
    },
    {
      "dot": "cyan",
      "title": "一句话类比",
      "items": [
        "vLLM 本体=只做文字代写的高速工作室",
        "vLLM-Omni=全媒体制作公司,各模态各占一个 stage 工位",
        "全双工会话=不挂断的接线员"
      ]
    }
  ]
}
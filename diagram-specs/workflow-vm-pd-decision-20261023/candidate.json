      "icon": "clock",
      "width": 168
    },
    {
      "id": "cheap",
      "lane": "ln_cost",
      "col": 3,
      "type": "security",
      "label": "KV 传输 < TTFT 预算?",
      "sublabel": "同节点双实例先打日志实测时延",
      "icon": "decision",
      "width": 168
    },
    {
      "id": "gain",
      "lane": "ln_gain",
      "col": 4,
      "type": "security",
      "label": "goodput 真涨了?",
      "sublabel": "双 SLO 同时达标的请求比例",
      "icon": "decision",
      "width": 168
    },
    {
      "id": "adopt",
      "lane": "ln_end",
      "col": 5,
      "type": "cloud",
      "label": "上 PD:同节点 → 跨节点",
      "sublabel": "先 NVLink,再 RDMA/NIXL;不达标就回退",
      "icon": "success",
      "width": 168
    },
    {
      "id": "stay",
      "lane": "ln_end",
      "col": 5,
      "type": "backend",
      "label": "停在软融合",

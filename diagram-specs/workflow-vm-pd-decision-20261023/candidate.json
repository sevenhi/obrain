      "width": 168,
      "yOffset": 118
    },
    {
      "id": "preempt",
      "lane": "ln_diag",
      "col": 2,
      "type": "database",
      "label": "抢占率才是瓶颈?",
      "sublabel": "preemptions_total 高 → 先修分页",
      "icon": "failure",
      "width": 168,
      "yOffset": 118
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": "baseline",

  "meta": {
    "title": "该不该上 PD 分离:四道门按顺序问,任何一道不过就停在软融合",
    "subtitle": "口袋规则:先证明「混批在互相污染」,再证明「传输不贵」,最后才谈异构专化。顺序颠倒就会买一整套网络与运维复杂度,却换不回 TTFT",
    "locale": "zh-CN",
    "output": "diagrams/vm-pd-decision.workflow.html"
  },
  "lanes": [
    {
      "id": "ln_base",
      "label": "① 先有基线"
    },
    {
      "id": "ln_diag",
      "label": "② 诊断真有污染吗"
    },
    {
      "id": "ln_cost",
      "label": "③ 传输贵不贵"
    },
    {
      "id": "ln_gain",
      "label": "④ 收益覆盖成本"
    },
    {
      "id": "ln_end",
      "label": "落地结论"
    }
  ],
  "phases": [
    {
      "id": "ph1",
      "label": "不许跳过基线",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "ph2",
      "label": "两道硬门槛",
      "fromCol": 2,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "ph3",
      "label": "结论与顺序",
      "fromCol": 4,
      "toCol": 5
    }
  ],
  "mainPath": [
    "baseline",
    "pollute",
    "tput",
    "cheap",
    "gain",
    "adopt"
  ],
  "nodes": [
    {
      "id": "baseline",
      "lane": "ln_base",
      "col": 0,
      "type": "frontend",
      "label": "单体基线跑三条曲线",

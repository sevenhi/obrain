      "icon": "start",
      "width": 168
    },
    {
      "id": "pollute",
      "lane": "ln_diag",
      "col": 1,
      "type": "security",
      "label": "长 prompt 在污染 TPOT?",
      "sublabel": "TPOT p95/p99 随长 prompt 抖吗",
      "icon": "decision",
      "width": 168
    },
    {
      "id": "tput",
      "lane": "ln_diag",
      "col": 2,
      "type": "security",
      "label": "量出 TTFT / TPOT 分位",

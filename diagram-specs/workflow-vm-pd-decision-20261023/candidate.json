      "variant": "emphasis"
    },
    {
      "id": "e2",
      "from": "pollute",
      "to": "tput",
      "label": "抖了 → 量化两侧分位",
      "role": "main",
      "variant": "emphasis"
    },
    {
      "id": "e3",
      "from": "tput",
      "to": "cheap",
      "label": "拿到 TTFT 预算基线",
      "role": "main"
    },
    {
      "id": "e4",
      "from": "cheap",
      "to": "gain",
      "label": "不贵才继续",
      "role": "main",
      "variant": "emphasis"
    },
    {
      "id": "e5",
      "from": "gain",
      "to": "adopt",
      "label": "涨了 → 扩到跨节点",
      "role": "main"
    },
    {
      "id": "e6",
      "from": "baseline",
      "to": "small",
      "label": "先排除小模型场景",
      "role": "branch",
      "variant": "dashed"
    },
    {
      "id": "e7",
      "from": "small",
      "to": "stay",
      "label": "不值得 → 先调 continuous batching",
      "role": "branch",
      "variant": "dashed"
    },
    {
      "id": "e8",
      "from": "pollute",
      "to": "preempt",
      "label": "不抖 → 查是否装不下",
      "role": "branch",
      "variant": "dashed"
    },
    {
      "id": "e9",
      "from": "preempt",
      "to": "stay",
      "label": "抢占高 → 修分页与显存",
      "role": "branch",
      "variant": "security"
    },
    {
      "id": "e10",
      "from": "cheap",
      "to": "stay",
      "label": "太贵 → 停在同节点或回退",
      "role": "error",
      "variant": "security"
    },
    {
      "id": "e11",
      "from": "gain",
      "to": "stay",
      "label": "没涨 → 回退单体",
      "role": "error",
      "variant": "security"
    }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "三个「先别上」的信号",
      "items": [
        "短 prompt / 高并发 / 输出短(分类、改写、轻聊天):prefill 占比低,传输与调度开销吃掉收益",
        "小模型(≤7B)或单卡就吃满:传输 + 运维成本超过收益",
        "KV 使用率与抢占才是瓶颈:PD 不解决「装不下」"
      ]
    },
    {
      "dot": "emerald",
      "title": "该上的三类场景",
      "items": [
        "长 prompt、输出中短、并发中等(文档问答 / RAG / agent 入口)",
        "超长上下文、多轮共享前缀:配 KV 池,前缀复用 + 跨实例共享收益大",
        "已有大规模多实例 / 异构 GPU:高算力卡跑 prefill、高带宽卡跑 decode 是直接红利"
      ]
    },
    {
      "dot": "amber",
      "title": "与相邻优化的关系(别叠错 buff)",
      "items": [
        "投机解码 / MTP:正交,落在 decode 池内,改变不了 prefill/decode 资源画像",
        "Prefix caching:强相关,分离后更需要跨实例共享,否则每次重算 system prompt",
        "KV 量化:正交且同步降低传输量,但两端格式必须一致"
      ]
    },
    {
      "dot": "cyan",
      "title": "成本表(定性)",
      "items": [
        "GPU 算力:更贴负载可异构,但总卡数未必减少",
        "网络:多出 KV 传输带宽与尾延迟,跨节点时不可忽视",
        "运维:两套实例、两套指标、一套配对路由,故障面翻倍"
      ]
    }
  ]
}
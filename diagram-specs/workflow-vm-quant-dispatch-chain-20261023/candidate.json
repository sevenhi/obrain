      "id": "e7",
      "from": "getmethod",
      "to": "ignored",
      "label": "该层被忽略",
      "role": "branch",
      "variant": "dashed"
    },
    {
      "id": "e8",
      "from": "verify",
      "to": "mismatch",
      "label": "名字不一致",
      "role": "error",
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "先记住一个反转直觉",
      "items": [
        "Config 从不写死内核,只管「这层用什么量化」(语义)",
        "kernel 选择器只管「用什么内核实现」(机制)",
        "两层靠 QuantKey / MPLinearLayerConfig 对接:改内核不进 Config"
      ]
    },
    {
      "dot": "cyan",
      "title": "三个决策点(排查入口)",
      "items": [
        "注册表:方法名映射错了,整条链从第一步就歪",
        "按层分派:gptq 排在 override 探测列表最前,越靠前越先判定",
        "kernel 选型:硬件能力决定落 CUTLASS 还是 Marlin"
      ]
    },
    {
      "dot": "emerald",
      "title": "本版(v0.28)三大结构变化",
      "items": [
        "gptq/awq/gptq_marlin/awq_marlin 合并为 auto_gptq.py / auto_awq.py",
        "LinearMethod 不再各自 repack,统一委托 choose_mp_linear_kernel()",
        "在线量化与离线 checkpoint 在同一个 get_quant_method 里分派"
      ]
    }
  ]

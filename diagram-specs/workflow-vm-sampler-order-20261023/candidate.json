{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Sampler 的步骤为什么必须排成这样:按「argmax 是否被改变」分组",
    "subtitle": "同一条 GPU 管线上,logits processor 被分成两组:温度之前的那组会改变贪心结果,温度之后的那组不会。min_p 之所以放在温度后不是随手摆的,是 argmax 不变性的直接推论",
    "locale": "zh-CN",
    "output": "diagrams/vm-sampler-order.workflow.html"
  },
  "lanes": [
    { "id": "ln_pre", "label": "① 温度之前(改数值)" },
    { "id": "ln_mid", "label": "② 温度本身" },
    { "id": "ln_post", "label": "③ 温度之后(砍候选)" },
    { "id": "ln_why", "label": "④ 为什么站这位" }
  ],
  "phases": [
    { "id": "p1", "label": "原始 logits", "fromCol": 0, "toCol": 1 },
    { "id": "p2", "label": "重塑分布", "fromCol": 2, "toCol": 2, "variant": "emphasis" },
    { "id": "p3", "label": "截断后采样", "fromCol": 3, "toCol": 4 }
  ],
  "nodes": [
    { "id": "n_logprobs", "lane": "ln_pre", "col": 0, "type": "backend", "label": "预留 logprobs", "sublabel": "用原始 logits", "icon": "start" },
    { "id": "n_mask", "lane": "ln_pre", "col": 1, "type": "security", "label": "掩码 + 三惩罚", "sublabel": "白名单→bad words→惩罚", "icon": "decision" },
    { "id": "n_temp", "lane": "ln_mid", "col": 2, "type": "backend", "label": "温度缩放", "sublabel": "div_(temp),<1e-5 置 1", "icon": "active" },
    { "id": "n_trunc", "lane": "ln_post", "col": 3, "type": "backend", "label": "min_p + top-k/p", "sublabel": "TopKTopPSampler", "icon": "neutral" },
    { "id": "n_pick", "lane": "ln_post", "col": 4, "type": "backend", "label": "逐行选 token", "sublabel": "贪心或指数竞赛", "icon": "success" },

    { "id": "w1", "lane": "ln_why", "col": 0, "type": "cloud", "label": "要「模型本来怎么想」", "sublabel": "V0 用处理后 logits,V1 改了", "icon": "none" },
    { "id": "w2", "lane": "ln_why", "col": 1, "type": "cloud", "label": "会改变贪心的必须在前", "sublabel": "min tokens / logit bias 也属这组", "icon": "none" },
    { "id": "w3", "lane": "ln_why", "col": 2, "type": "cloud", "label": "数值改完才重塑", "sublabel": "惩罚要看到完整历史 token", "icon": "none" },
    { "id": "w4", "lane": "ln_why", "col": 3, "type": "cloud", "label": "argmax 不变,所以能放后面", "sublabel": "min_p 与 temp=0 可共存", "icon": "none" },
    { "id": "w5", "lane": "ln_why", "col": 4, "type": "cloud", "label": "混批:同 batch 参数各异", "sublabel": "逐行判断而非整批分支", "icon": "none" }
  ],
  "edges": [
    { "id": "e1", "from": "n_logprobs", "to": "n_mask", "label": "同一条 GPU 流水线,不落 CPU", "role": "main" },
    { "id": "e2", "from": "n_mask", "to": "n_temp", "label": "已见 token 的 logit 先改完", "role": "main" },
    { "id": "e3", "from": "n_temp", "to": "n_trunc", "label": "概率形状定型后才截断", "role": "main" },
    { "id": "e4", "from": "n_trunc", "to": "n_pick", "label": "只在保留候选里选", "role": "main" },
    { "id": "e5", "from": "n_logprobs", "to": "w1", "label": "", "variant": "dashed", "role": "async" },
    { "id": "e6", "from": "n_mask", "to": "w2", "label": "", "variant": "dashed", "role": "async" },
    { "id": "e7", "from": "n_temp", "to": "w3", "label": "", "variant": "dashed", "role": "async" },
    { "id": "e8", "from": "n_trunc", "to": "w4", "label": "", "variant": "dashed", "role": "async" },
    { "id": "e9", "from": "n_pick", "to": "w5", "label": "", "variant": "dashed", "role": "async" }
  ],
  "mainPath": ["n_logprobs", "n_mask", "n_temp", "n_trunc", "n_pick"],
  "cards": [
    {
      "dot": "cyan",
      "title": "三类惩罚插在哪一格",
      "items": [
        "repetition → frequency → presence,在 min tokens / logit bias 之后、温度之前",
        "惩罚改的是「已见 token 的 logit」,必须在温度重塑分布前完成",
        "推测解码时先把草稿 token 并入 output_token_ids 再施惩罚,否则草稿重复不受罚"
      ]
    },
    {
      "dot": "violet",
      "title": "为什么 V1 用原始 logits 算 logprobs",
      "items": [
        "源码注释 NOTE(woosuk) 明写:在惩罚与温度缩放之前取 top-k logprobs",
        "语义上是「模型本来怎么想」,不是「惩罚后还剩多少」",
        "V0 用的是采样时的处理后 logits——查旧资料时最容易踩的差异"
      ]
    },
    {
      "dot": "rose",
      "title": "这套分组框架是版本新增的",
      "items": [
        "旧版是 logits_processors 列表逐个应用,没有不变性概念",
        "V1 拆成 interface / builtin / state,元数据挂 SamplingMetadata.logitsprocs",
        "读代码认 vllm/v1/sample/,别照旧博客的调用链"
      ]
    }
  ]
}

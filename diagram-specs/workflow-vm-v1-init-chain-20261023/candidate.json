  "cards": [
    {
      "dot": "cyan",
      "title": "两个公式(可直接抄)",
      "items": [
        "kv_cache_bytes = total_memory × gpu_memory_utilization − (weights + activations 峰值)",
        "num_blocks = kv_cache_bytes ÷ (num_layers × num_kv_heads × block_size × head_dim × 2 × dtype_bytes)",
        "单块大小里的 ×2 是 K 和 V 各一份"
      ]
    },
    {
      "dot": "rose",
      "title": "为什么必须 profiling",
      "items": [
        "权重大小可算,但激活峰值取决于 kernel 实现与 batch 形状,算不准",
        "写死会让显存要么浪费、要么 OOM",
        "所以先跑一遍 dummy batch,用 max_memory_allocated 差值实测"
      ]
    },
    {
      "dot": "emerald",
      "title": "调参入口就一个",
      "items": [
        "想给 KV 更多空间 → 调高 gpu_memory_utilization",
        "它同时影响「能装多少并发」与「会不会 OOM」",
        "启动日志里的 KV cache 块数就是这条链的输出"
      ]
    }
  ]
